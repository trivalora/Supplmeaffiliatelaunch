{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "build",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "ts-node": {
    "esm": true
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts"]
}
