{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "build",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "ts-node": {
    "esm": true
  },
"include": ["scripts/**/*.ts", "src/**/*.ts", "api/**/*.ts"]
}
