{
  "name": "supplement-info-platform",
  "version": "2.0.0",
  "description": "Evidence-based supplement information platform with meta-analysis reviews",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "predeploy": "npm run build && echo 'suppl.me' > build/CNAME",
    "deploy": "gh-pages -d build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.294.0",
    "recharts": "^2.10.3",
    "motion": "^10.16.0",
    "react-hook-form": "^7.55.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "gh-pages": "^6.1.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  },
  "keywords": [
    "supplements",
    "health",
    "nutrition",
    "evidence-based",
    "meta-analysis",
    "research",
    "vitamins",
    "minerals",
    "probiotics",
    "omega-3"
  ],
  "author": "Your Name",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/trivalora/Supplmeaffiliatelaunch.git"
  },
  "bugs": {
    "url": "https://github.com/trivalora/Supplmeaffiliatelaunch/issues"
  },
  "homepage": "https://suppl.me"
}