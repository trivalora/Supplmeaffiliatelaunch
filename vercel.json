{
  "framework": "vite",
  "buildCommand": "npm run build:images",
  "installCommand": "npm ci",
  "outputDirectory": "build",

  "functions": {
    "api/**/*.{ts,js}": {
      "runtime": "nodejs24.1.0"
    }
  },

  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}