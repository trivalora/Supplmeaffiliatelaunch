{
  "framework": "vite",
  "buildCommand": "npm run build:images",
  "installCommand": "npm ci",
  "outputDirectory": "build",

"functions": {
  "api/**/*.ts": { "runtime": "vercel/node@22.x" },
  "api/**/*.js": { "runtime": "vercel/node@22.x" }
},

  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}