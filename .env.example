# Example environment variables
# Copy to .env and fill in your actual values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.suppl.me
NEXT_PUBLIC_CANONICAL_BASE_URL=https://www.suppl.me

# Analytics
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_HOTJAR_ID=1234567
NEXT_PUBLIC_CLARITY_ID=abcdefghij

# Database (for local data processing)
PGHOST=localhost
PGPORT=5432
PGUSER=youruser
PGPASSWORD=yourpassword
PGDATABASE=supplme
PGSSL=disable
DSLD_DB_PATH=../input/Supplement Databases (trivalora)/DSLD db/dsld.sqlite

# Scraping Credentials
IHERB_EMAIL=your_email@example.com
IHERB_PASSWORD=your_password_here
SCRAPERAPI_KEY=your_scraperapi_key_here
