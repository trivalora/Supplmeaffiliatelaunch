# Example environment variables for v0.2
VITE_CANONICAL_BASE_URL=https://www.suppl.me
VITE_GTM_ID=GTM-XXXXXXX
API_KEY_FAVORITES=your-api-key
PGHOST=localhost
PGPORT=5432
PGUSER=youruser
PGPASSWORD=yourpassword
PGDATABASE=supplme
PGSSL=disable
DSLD_DB_PATH=../input/Supplement Databases (trivalora)/DSLD db/dsld.sqlite

# iHerb credentials for authenticated scraping (to access "See price in cart" products)
IHERB_EMAIL=your_email@example.com
IHERB_PASSWORD=your_password_here

# ScraperAPI key for bypassing bot detection (https://www.scraperapi.com/)
# Sign up at https://www.scraperapi.com/signup - Free tier: 5,000 requests/month
SCRAPERAPI_KEY=your_scraperapi_key_here
